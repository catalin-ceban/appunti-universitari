% Nuovo titol del capitolo
\newcommand{\etichettaCapitolo}{%
  \color{coloreNumeroCapitolo}\fontsize{100}{100}\selectfont\thechapter}

\titleformat{\chapter}[display]
  {\normalfont\raggedleft}
  {\etichettaCapitolo}
  {5pt}
  {\Huge\bfseries\color{coloreTitoloCapitolo}}

% Spaziature per i vari ambienti
\titlespacing*{\chapter}{0pt}{-40pt}{20pt}
\titlespacing*{\section}{0pt}{5pt}{3pt}
\titlespacing*{\subsection}{0pt}{5pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{5pt}{3pt}


% Aggiunta: header e footer (solo spaziatura)
\renewcommand{\chaptermark}[1]{\markboth{\@chapapp\ \thechapter\ --\ #1}{}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\rmfamily\footnotesize\leftmark}
\fancyhead[R]{\rmfamily\bfseries\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\rmfamily\footnotesize\leftmark}%
  \fancyhead[R]{\rmfamily\bfseries\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}


% Come nello stile precedente, la generazione del frontespizio
\newcommand{\generaFrontespizio}[4]{
    \begin{titlepage}

		\begin{center}

			\hbox{}
			\vfill

			{
				\color{rossoSapienza}
				\bfseries
				\fontsize{40pt}{40pt}\selectfont
				#1
				\par
			}

			\vspace{0.5cm}

			\vfill
			\hbox{}

			\begin{minipage}{1\textwidth}
				\fontsize{12pt}{14pt}\selectfont \textit{I seguenti appunti sono a cura di \textbf{Catalin Ceban} e si basano sul corso di "#1" erogato nell'A.A. #2 
				\ifstrequal{#4}{m}{ dal professore}{\ifstrequal{#4}{p}{ dai professori}{ dalla professoressa}} #3 per il C.d.L Informatica (33503)}
			\end{minipage}

			\vspace{0.5cm}
			{\large \today}

		\end{center}

	\end{titlepage}

	\tableofcontents
	\clearpage

}


% Definizione dei nuovi box colorati
\tcbset{
	stileBoxTarc/.style={
		enhanced, breakable,
		colback=white, colframe=#1,
		fonttitle=\bfseries\rmfamily, coltitle=black,
		attach boxed title to top left={xshift=3mm, yshift=-3mm},
		boxed title style={colback=#1, colframe=#1, arc=1.5mm},
		before skip=18pt, after skip=18pt,
		top=4mm, pad after break=2mm
	}
}

\newtcbtheorem[number within=section]{teorema}{Teorema}{stileBoxTarc=boxTeorema}{th}
\newtcbtheorem[number within=section]{definizione}{Definizione}{stileBoxTarc=boxDefinizione}{def}
\newtcbtheorem[number within=section]{proposizione}{Proposizione}{stileBoxTarc=boxProposizione}{prop}
\newtcbtheorem[number within=section]{corollario}{Corollario}{stileBoxTarc=boxCorollario}{cor}
\newtcbtheorem[number within=section]{osservazione}{Osservazione}{stileBoxTarc=boxOsservazione}{oss}
\newtcbtheorem[number within=section]{dimostrazione}{Dimostrazione}{stileBoxTarc=boxDimostrazione}{oss}
\newtcbtheorem[number within=section]{algoritmo}{Spiegazione algoritmo}{stileBoxTarc=boxAlgoritmo}{alg}
\newtcbtheorem[number within=section]{esercizio}{Esercizio}{stileBoxTarc=boxEsercizio}{es}

